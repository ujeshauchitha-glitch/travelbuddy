rules_version = '2';

// TravelBuddy security rules.
// Privacy and safety are enforced HERE (server side), never only in the UI.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    // Verified Google account on the campus domain. Checked on the token, so it
    // cannot be bypassed from the client.
    function isCampus() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@vitstudent[.]ac[.]in');
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }

    // A connection exists between two users once a host accepted the other
    // into one of their trips. Document id is "<hostUid>_<memberUid>".
    function connected(a, b) {
      return exists(/databases/$(database)/documents/connections/$(a + '_' + b))
        || exists(/databases/$(database)/documents/connections/$(b + '_' + a));
    }

    function canSeeField(ownerUid, field) {
      let vis = get(profilePath(ownerUid)).data.contactVisibility[field];
      return vis == 'campus'
        || (vis == 'travelmates' && connected(ownerUid, request.auth.uid));
    }

    function validVisibility(v) {
      return v in ['campus', 'travelmates', 'me'];
    }

    // Self-declared gender, used to enforce women-only / men-only trips.
    // get() on a missing document fails, which safely denies the request.
    function genderOf(uid) {
      return get(/databases/$(database)/documents/profiles/$(uid)/private/gender).data.value;
    }

    function audienceOk(trip, uid) {
      let aud = trip.get('audience', 'anyone');
      return aud == 'anyone'
        || (aud == 'women_only' && genderOf(uid) == 'woman')
        || (aud == 'men_only' && genderOf(uid) == 'man');
    }

    function isBlocked(by, who) {
      return exists(/databases/$(database)/documents/profiles/$(by)/blocked/$(who));
    }

    // ---------- profiles ----------
    match /profiles/{uid} {
      allow read: if isCampus();

      allow create, update: if isCampus() && isSelf(uid)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && (!('hometown' in request.resource.data) || request.resource.data.hometown.size() <= 80)
        && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 280)
        && (!('travelPref' in request.resource.data)
            || request.resource.data.travelPref in ['anyone', 'women_only', 'men_only'])
        && validVisibility(request.resource.data.contactVisibility.phone)
        && validVisibility(request.resource.data.contactVisibility.email)
        && validVisibility(request.resource.data.contactVisibility.instagram)
        && validVisibility(request.resource.data.contactVisibility.gender);

      allow delete: if false;

      // Contact details and gender live in separate documents so each one can
      // have its own visibility: /profiles/{uid}/private/{field}
      match /private/{field} {
        allow read: if isCampus()
          && (isSelf(uid) || canSeeField(uid, field));

        allow create, update: if isCampus() && isSelf(uid)
          && request.resource.data.keys().hasOnly(['value'])
          && request.resource.data.value is string
          && (
            (field == 'phone'
              && request.resource.data.value.matches('^[+]?[0-9 ()-]{7,20}$'))
            || (field == 'email'
              && request.resource.data.value == request.auth.token.email)
            || (field == 'instagram'
              && request.resource.data.value.matches('^[A-Za-z0-9._]{1,30}$'))
            || (field == 'gender'
              && request.resource.data.value in ['woman', 'man', 'nonbinary', 'prefer_not'])
          );

        allow delete: if isCampus() && isSelf(uid);
      }

      // People this user has blocked. Only the owner manages the list; the
      // chat rules look it up to stop blocked people from messaging.
      match /blocked/{other} {
        allow read, create, delete: if isCampus() && isSelf(uid);
        allow update: if false;
      }
    }

    // ---------- trips ----------
    match /trips/{tripId} {
      allow read: if isCampus();

      allow create: if isCampus()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.mode in
             ['cab', 'train', 'flight', 'bus', 'auto', 'metro', 'ferry', 'bike', 'other']
        && request.resource.data.origin.name is string
        && request.resource.data.origin.name.size() > 0
        && request.resource.data.origin.name.size() <= 120
        && request.resource.data.destination.name is string
        && request.resource.data.destination.name.size() > 0
        && request.resource.data.destination.name.size() <= 120
        && request.resource.data.departAt is timestamp
        && request.resource.data.departAt > request.time
        && request.resource.data.spotsOpen is int
        && request.resource.data.spotsOpen >= 1
        && request.resource.data.spotsOpen <= 20
        && request.resource.data.audience in ['anyone', 'women_only', 'men_only']
        // A women-only trip can only be hosted by a woman, men-only by a man.
        && audienceOk(request.resource.data, request.auth.uid);

      // Only the host edits or deletes a trip. The host can never be swapped
      // and the audience can never be changed after people have requested.
      allow update: if isCampus()
        && resource.data.hostId == request.auth.uid
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.get('audience', 'anyone') == resource.data.get('audience', 'anyone');
      allow delete: if isCampus() && resource.data.hostId == request.auth.uid;

      match /requests/{uid} {
        function tripData() {
          return get(/databases/$(database)/documents/trips/$(tripId)).data;
        }

        // The requester and the trip's host can see a join request.
        allow read: if isCampus() && (isSelf(uid) || tripData().hostId == request.auth.uid);

        allow create: if isCampus() && isSelf(uid)
          && tripData().hostId != request.auth.uid
          && request.resource.data.status == 'pending'
          && audienceOk(tripData(), request.auth.uid);

        // Host decides.
        allow update: if isCampus() && tripData().hostId == request.auth.uid
          && request.resource.data.status in ['accepted', 'declined'];

        allow delete: if isCampus() && (isSelf(uid) || tripData().hostId == request.auth.uid);
      }
    }

    // ---------- connections ----------
    match /connections/{connId} {
      allow read: if isCampus() && request.auth.uid in resource.data.uids;

      // Created by the host when accepting a join request; never editable.
      allow create: if isCampus()
        && connId == request.auth.uid + '_' + request.resource.data.memberUid
        && request.resource.data.uids == [request.auth.uid, request.resource.data.memberUid]
        && get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.hostId
             == request.auth.uid
        && get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)/requests/$(request.resource.data.memberUid)).data.status
             == 'accepted';

      allow update, delete: if false;
    }

    // ---------- private chat ----------
    // Conversation id is the two uids sorted and joined with '_'.
    match /conversations/{cid} {
      function otherUid(uids) {
        return uids[0] == request.auth.uid ? uids[1] : uids[0];
      }

      allow read: if isCampus()
        && (resource == null || request.auth.uid in resource.data.uids);

      // A chat starts from a trip: one of the two people must be that trip's
      // host. This stops random cold messages to strangers.
      allow create: if isCampus()
        && request.resource.data.uids.size() == 2
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.uids[0] != request.resource.data.uids[1]
        && cid == (request.resource.data.uids[0] < request.resource.data.uids[1]
             ? request.resource.data.uids[0] + '_' + request.resource.data.uids[1]
             : request.resource.data.uids[1] + '_' + request.resource.data.uids[0])
        && get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.hostId
             in request.resource.data.uids
        && !isBlocked(otherUid(request.resource.data.uids), request.auth.uid);

      // Only the preview fields may change after creation.
      allow update: if isCampus()
        && request.auth.uid in resource.data.uids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastAt'])
        && !isBlocked(otherUid(resource.data.uids), request.auth.uid);

      allow delete: if false;

      match /messages/{mid} {
        allow read: if isCampus()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.uids;

        // getAfter so the first message can be written in the same batch as
        // the conversation document.
        allow create: if isCampus()
          && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(cid)).data.uids
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && !isBlocked(otherUid(getAfter(/databases/$(database)/documents/conversations/$(cid)).data.uids),
                        request.auth.uid);

        allow update, delete: if false;
      }
    }

    // ---------- issues, safety reports and feedback ----------
    // Users can file reports and read back only their own. Triage happens in
    // the Firebase console, so no in-app admin account exists to be abused.
    match /issues/{id} {
      allow create: if isCampus()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.category in ['bug', 'safety', 'account', 'feedback']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.status == 'open';
      allow read: if isCampus() && resource.data.authorId == request.auth.uid;
      allow update, delete: if false;
    }

    // Everything else is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
